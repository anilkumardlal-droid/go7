    <link rel="shortcut icon" href="images/favicon.png" />
    <link rel="stylesheet" type="text/css" href="css/animate.min.css" />
    <link href="css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="css/materialdesignicons.min.css" rel="stylesheet" type="text/css" />
    <link href="css/style.min.css" rel="stylesheet" type="text/css" />
    <link href="css/home.css" rel="stylesheet" type="text/css" />
    <link rel="canonical" href="https://www.go7.in/" />

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      body.vh-100 {
        min-height: 100vh;
        min-height: 100svh;
        background: #fcfcfc;
      }

      .contain-box.go7-home {
        min-height: calc(100vh - 120px);
        min-height: calc(100svh - 120px);
      }

      .go7-home .home-desc-center {
        min-height: calc(100vh - 120px);
        min-height: calc(100svh - 120px);
        display: flex;
        align-items: center;
      }

      .go7-home-content {
        max-width: 620px;
      }

      .go7-home-content .home-title {
        margin-bottom: 0;
      }

      .go7-home-description {
        max-width: 560px;
        font-size: 18px;
        line-height: 1.65;
      }

      .go7-home-button {
        margin-top: 26px;
      }

      .go7-home-space {
        min-height: 360px;
      }

      @media (max-width: 991px) {
        .contain-box.go7-home,
        .go7-home .home-desc-center {
          min-height: auto;
        }

        .go7-home .home-desc-center {
          padding-top: 55px;
          padding-bottom: 65px;
        }

        .go7-home-content {
          max-width: 700px;
          text-align: center;
          margin: 0 auto;
        }

        .go7-home-description {
          margin-left: auto;
          margin-right: auto;
        }

        .go7-home-space {
          min-height: 80px;
        }
      }

      @media (max-width: 575px) {
        .go7-home .home-desc-center {
          padding-top: 35px;
          padding-bottom: 45px;
        }

        .go7-home-content .home-title {
          font-size: 48px;
        }

        .go7-home-description {
          font-size: 16px;
        }

        .go7-home-button {
          margin-top: 22px;
        }
      }
    </style>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "GO7.IN",
        "url": "https://www.go7.in/",
        "description": "Premium .IN domain portfolio.",
        "publisher": {
          "@type": "Person",
          "name": "Anil Srivastav"
        }
      }
